# FastAPI Text2SQL Application Environment Variables
# Copy this file to .env and replace with your actual values

# API keys for authentication (comma-separated list, checked in order)
# Use API_KEYS for multiple keys. The legacy API_KEY single-value is still accepted.
API_KEYS=key_for_app,key_for_mcp,key_for_scripts
# API_KEY=your_single_key_here    # legacy fallback — used only if API_KEYS is not set
# This instance's port, and its name (FASTAPI-TEXT2SQL-412). One instance = one clone folder +
# its own .env: the port is declared here and nowhere else, the version decides nothing.
# Production: blue 8186, green 8187, violet 8188, brown 8189 (doc/instances.md).
API_PORT=8010
# Optional: restart.sh defaults it to the folder suffix (fastapi-text2sql-violet -> violet).
# Written in every log record and returned by GET / as "instance".
# INSTANCE_NAME=blue

# OpenAI: no key here. Each client sends its own in the X-OpenAI-Key header of every
# request, and the API pays every OpenAI call of that request with it (embeddings included).
# An OPENAI_API_KEY line in this file is ignored.

# Optional: Anthropic API Key (Claude)
# Only required if using llm_model_* = "claude-sonnet-4-6"
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Google API Key (Gemini)
# Required if using llm_model_* = "gemini-2.5-flash" or "gemma-4-google"
GOOGLE_API_KEY=your_google_api_key_here

# Optional: OpenRouter API Key
# Required if using llm_model_entity_extraction = "gemma-4" or llm_model_text2sql = "gemma-4"
OPENROUTER_API_KEY=your_openrouter_api_key_here

# MySQL Database Configuration
# Replace with your actual MySQL database credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name
# Optional separate SELECT-only account for generated SQL. Set both together.
# Grant SELECT only on the tables in generated_sql_guard.READ_MODEL_TABLES.
# DB_GENERATED_USER=your_query_only_username
# DB_GENERATED_PASSWORD=your_query_only_password

TIMINGS=1
BKTREE_ENABLED=1

# Entity resolution scheduling (FASTAPI-TEXT2SQL-201).
# 1 (default): resolve the entities in a worker thread while the text-to-SQL call is
#    in flight, so only the string substitution waits for the SQL.
# 0: strictly sequential (extraction, then SQL, then resolution). Same results.
ENTITY_RESOLUTION_PARALLEL=1

# Caching of empty results (FASTAPI-TEXT2SQL-212).
# 0 (default): a query that returned 0 rows on page 1 is never written to cache. An empty
#    result is exactly where the odds of a defective query are highest, and caching one
#    freezes it for the whole anonymized template, not just the question that produced it.
# 1: restore the old behaviour and cache empty results too.
CACHE_EMPTY_RESULTS=0

# ChromaDB server configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# MCP (Model Context Protocol) at /mcp, for Claude, ChatGPT and other MCP clients.
# Behind a GitHub login through FastMCP's OAuth proxy (mcp_auth.py). Any setting left empty
# refuses every MCP tool call (startup says which one is missing).
# Public URL of the MCP host, without /mcp. GitHub OAuth app callback: <this>/auth/callback
MCP_PUBLIC_BASE_URL=https://mcp.example.com
# The GitHub OAuth app (github.com > Settings > Developer settings > OAuth Apps)
MCP_GITHUB_CLIENT_ID=
MCP_GITHUB_CLIENT_SECRET=
# GitHub logins allowed to see and call the tools, comma-separated. GitHub authenticates
# ANY GitHub user: this list is what keeps the server private.
MCP_ALLOWED_GITHUB_LOGINS=
# Both keys must be IDENTICAL in every instance .env, or a switch or a restart logs every
# client out. Signing key: openssl rand -hex 32
MCP_OAUTH_JWT_SIGNING_KEY=
# Fernet key of the OAuth store: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_OAUTH_STORAGE_KEY=
# Optional, default "mcp-oauth" (restart.sh mounts shared_data there)
# MCP_OAUTH_STORAGE_DIR=mcp-oauth
# OpenAI key sent by sql_search (the API holds none). Empty: sql_search serves cache hits only.
# A stopgap until each user stores their own key on the account page.
MCP_OWNER_OPENAI_KEY=
# Host of the public web front (no trailing slash). sql_search tells the model to link result
# IDs to its pages under /en/ or /fr/ (movie.php?movieid=..., person.php?personid=...).
# Empty: the model is told not to make links.
MCP_ENTITY_LINK_BASE_URL=

# Internal API key used by MCP tools when they call the FastAPI entity endpoints.
# Must be one of the keys listed in API_KEYS (or API_KEY if using the legacy variable).
# Defaults to the first entry of API_KEYS at runtime if not set explicitly.
MCP_INTERNAL_API_KEY=key_for_mcp

# Base URL the MCP tools use to reach the FastAPI server internally.
# Defaults to http://127.0.0.1:<API_PORT>, this instance itself.
# Override only if the server is behind a proxy.
# MCP_INTERNAL_BASE_URL=http://127.0.0.1:8010
